{
    "version": 6,
    "configurePresets": [
        {
            "name": "native",
            "displayName": "Native build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            }
        },
        {
            "name": "mingw",
            "displayName": "Windows x86_64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/mingw-x86_64.cmake"
            }
        },
        {
            "name": "web",
            "displayName": "Build to web browser (HTML5 with Emscripten)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/web",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "/usr/lib/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "VCPKG_TARGET_TRIPLET": "wasm32-emscripten"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "native",
            "configurePreset": "native"
        },
        {
            "name": "mingw",
            "configurePreset": "mingw"
        },
        {
            "name": "web",
            "configurePreset": "web"
        }
    ]
}
